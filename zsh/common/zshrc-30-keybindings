### General movement
bindkey "\e[5C" forward-word
bindkey "\e[5D" backward-word
bindkey "\e\e[C" forward-word
bindkey "\e\e[D" backward-word

### Tab completion navigation
bindkey '^i' expand-or-complete
bindkey "\e[Z" reverse-menu-complete

### Prefix history search
autoload -U up-line-or-beginning-search
autoload -U down-line-or-beginning-search
zle -N up-line-or-beginning-search
zle -N down-line-or-beginning-search

bindkey "\e[A" up-line-or-beginning-search
bindkey "\eOA" up-line-or-beginning-search
bindkey "\e[B" down-line-or-beginning-search
bindkey "\eOB" down-line-or-beginning-search

### Clear + remove scrollback
# TODO: For reasons I don't understand, this appears to be working for CMD+K
_clear_all() {
  # 3J = clear scrollback, 2J = clear screen, H = cursor home
  printf '\e[3J\e[2J\e[H'
  # In ZLE context, redraw prompt cleanly.
  if zle; then
    zle reset-prompt
  fi
}

zle -N _clear_all
bindkey '^L' _clear_all
