### Tab completion
# Reload command hash when completing command position after installs.
_force_rehash() {
    (( CURRENT == 1 )) && rehash
    return 1
}

# Offer interactive completion menu selection with correction strategies.
zstyle ':completion:*' menu select yes
zstyle ':completion:*:default' list-colors ''
zstyle ':completion:*' completer _force_rehash _complete _ignored _match _correct _approximate _prefix
zstyle ':completion:*' max-errors 2
zstyle ':completion:*' matcher-list '' 'm:{[:lower:][:upper:]}={[:upper:][:lower:]}' '+l:|=* r:|=*'

# Cache expensive completion lookups.
zstyle ':completion:*' use-cache on
DOTFILES_ROOT="${DOTFILES_ROOT:-$HOME/.dotfiles}"
ZSH_CACHE_DIR="$DOTFILES_ROOT/zsh/.cache"
zstyle ':completion:*' cache-path "$ZSH_CACHE_DIR"
[[ -d "$ZSH_CACHE_DIR" ]] || mkdir -p "$ZSH_CACHE_DIR"

# Hide noisy artifacts but keep rm unrestricted.
zstyle ':completion:*' ignored-patterns '*.pyc' '__pycache__'
zstyle ':completion:*:*:rm:*:*' ignored-patterns

zstyle :compinstall filename "$HOME/.zshrc"
setopt complete_in_word

autoload -Uz compinit
if [ "$(date +'%j')" != "$(stat -f '%Sm' -t '%j' ~/.zcompdump 2>/dev/null)" ]; then
    compinit
else
    compinit -C
fi

eval "$(/opt/homebrew/bin/uv generate-shell-completion zsh)"
